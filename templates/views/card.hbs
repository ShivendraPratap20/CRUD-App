<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{fullName}} - Profile Card</title>
    <link rel="stylesheet" href="/css/cardTmp.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="profile-container">
        <div class="profile-card">
            <div class="profile-header">
                <div class="profile-avatar-section">
                    <div class="profile-pic">
                        <form id="icon">
                            <input type="file" name="profilePic" id="profile-pic" class="form-control">
                            <i class="bi bi-camera-fill upload-icon"></i>
                        </form>
                        <img src="/images/man.png" id="profile-img" class="profile-avatar" alt="Profile Picture">
                        <div class="avatar-overlay"></div>
                    </div>
                </div>
            </div>
            <div class="profile-content">
                <div class="profile-basic-info">
                    <h2 class="profile-name info">{{fullName}}</h2>
                    <input type="text" name="fullName" id="fullName" value={{fullName}} readonly class="edit-input">

                    <p class="profile-title info">{{profession}}</p>
                    <input type="text" name="profession" id="profession" value={{profession}} readonly class="edit-input">
                </div>
                <div class="skills-section">
                    <h6 id="language-holder" class="skills-display">
                        {{#each languages}}
                        <span class="skill-tag">{{this}}</span>
                        {{/each}}
                    </h6>
                    <div id="language-change" class="skills-editor">
                        <h6 class="skills-editor-title">Programming Languages</h6>
                        <div class="skills-grid">
                            <div class="skill-item">
                                <input type="checkbox" name="language" id="java" value="Java" class="form-check-input">
                                <label for="java" class="form-check-label">Java</label>
                            </div>
                            <div class="skill-item">
                                <input type="checkbox" name="language" id="c" value="C" class="form-check-input">
                                <label for="c" class="form-check-label">C</label>
                            </div>
                            <div class="skill-item">
                                <input type="checkbox" name="language" id="python" value="Python" class="form-check-input">
                                <label for="python" class="form-check-label">Python</label>
                            </div>
                            <div class="skill-item">
                                <input type="checkbox" name="language" id="javascript" value="JavaScript" class="form-check-input">
                                <label for="javascript" class="form-check-label">JavaScript</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="contact-section">
                    <div class="contact-item">
                        <i class="bi bi-geo-alt-fill contact-icon"></i>
                        <span class="contact-text info">{{address}}</span>
                        <input type="text" name="address" id="address" value={{address}} readonly class="edit-input">
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-telephone-fill contact-icon"></i>
                        <span class="contact-text info">{{phone}}</span>
                        <input type="text" name="phone" id="phone" value={{phone}} readonly class="edit-input">
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-envelope-fill contact-icon"></i>
                        <span class="contact-text info">{{email}}</span>
                        <input type="email" name="email" id="email" value={{email}} readonly class="edit-input">
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button type="button" class="btn btn-primary action-btn" id="mdyBtn">
                        <i class="bi bi-pencil-square"></i> Edit Profile
                    </button>
                    <button type="button" class="btn btn-danger action-btn" id="delBtn">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                    <button type="button" class="btn btn-success action-btn" id="savBtn">
                        <i class="bi bi-check-circle"></i> Save Changes
                    </button>
                </div>
            </div>
        </div>
        <button type="button" class="btn btn-outline-danger logout-btn" id="lgtBtn">
            <i class="bi bi-box-arrow-right"></i> Logout
        </button>
        
    </div>
    <script src="/js/cardJS.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>